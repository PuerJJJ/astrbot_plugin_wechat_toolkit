{
  "tts_provider_id": {
    "description": "按需语音使用的TTS提供商",
    "type": "string",
    "default": "",
    "_special": "select_provider_tts",
    "hint": "选择已配置的TTS模型；留空使用当前会话的默认TTS。个人微信以音频文件发送。"
  },
  "enable_timing": {
    "description": "启用微信链路耗时诊断",
    "type": "bool",
    "default": false,
    "hint": "包装AstrBot 4.29.3内部方法，记录数字时延和工具名，保留2000条；更改后重载插件。"
  },
  "natural_shortcuts": {
    "description": "常见自然语言用量请求直接返回",
    "type": "bool",
    "default": true,
    "hint": "如今天花了多少钱、还剩多少额度；复杂表达可通过模型调用wechat_query_usage工具。"
  },
  "image_generation": {
    "description": "生图与改图",
    "type": "object",
    "items": {
      "enabled": {
        "description": "启用生图",
        "type": "bool",
        "default": false
      },
      "api_base": {
        "description": "生图API基础地址（含/v1）",
        "type": "string",
        "default": "",
        "hint": "填写你选择的OpenAI兼容服务基础地址，例如https://api.example.com/v1。"
      },
      "api_key": {
        "description": "生图API Key",
        "type": "string",
        "default": "",
        "secret": true
      },
      "model": {
        "description": "生图模型",
        "type": "string",
        "default": "gpt-image-2.5-sunburst",
        "hint": "生图模型可查询服务端列表；支持gpt-image-2、gpt-image-2.5-sunburst、gpt-image-2.5-flare，或手填其他兼容模型。"
      },
      "quality": {
        "description": "默认质量",
        "type": "string",
        "default": "low",
        "options": [
          "low",
          "medium",
          "high",
          "xhigh",
          "max",
          "auto"
        ]
      },
      "size": {
        "description": "文生图尺寸",
        "type": "string",
        "default": "1024x1024",
        "hint": "支持1024x1024等像素，或1:1、16:9、9:16、3:4、4:3等比例。"
      },
      "edit_size": {
        "description": "改图尺寸",
        "type": "string",
        "default": "auto",
        "hint": "改图单独尺寸，可设auto、像素或比例。"
      },
      "output_format": {
        "description": "图片格式",
        "type": "string",
        "default": "png",
        "options": [
          "png",
          "jpeg",
          "webp"
        ]
      },
      "background": {
        "description": "背景",
        "type": "string",
        "default": "auto",
        "options": [
          "auto",
          "opaque",
          "transparent"
        ]
      },
      "send_response_format": {
        "description": "显式发送response_format=b64_json",
        "type": "bool",
        "default": false,
        "hint": "通常无需开启；只在兼容服务要求该参数时开启。插件仅接收Base64图片。"
      },
      "timeout": {
        "description": "总超时（秒）",
        "type": "int",
        "default": 420,
        "slider": {
          "min": 180,
          "max": 600,
          "step": 30
        }
      },
      "max_retries": {
        "description": "失败后的最大重试次数",
        "type": "int",
        "default": 3,
        "slider": {
          "min": 0,
          "max": 3,
          "step": 1
        },
        "hint": "默认首次请求失败后再重试3次，共最多4次；每次向微信发进度。配置/权限错误不盲重试，超时重试可能产生额外计费。"
      },
      "retry_delay": {
        "description": "重试间隔（秒）",
        "type": "float",
        "default": 3,
        "slider": {
          "min": 0,
          "max": 30,
          "step": 1
        }
      },
      "extra_models": {
        "description": "额外手填生图模型ID",
        "type": "list",
        "default": [],
        "hint": "服务端未提供/models时用于显式添加兼容模型；不表示已实测权限和改图能力。"
      }
    }
  }
}
