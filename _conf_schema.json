{
  "tts_provider_id": {
    "description": "按需语音使用的TTS提供商",
    "type": "string",
    "default": "",
    "_special": "select_provider_tts",
    "hint": "选择已配置的TTS模型；留空使用当前会话的默认TTS。个人微信以音频文件发送。"
  },
  "enable_timing": {
    "description": "启用微信链路耗时诊断",
    "type": "bool",
    "default": false,
    "hint": "包装AstrBot 4.29.3内部方法，记录数字时延和工具名，保留2000条；更改后重载插件。"
  },
  "natural_shortcuts": {
    "description": "常见自然语言用量请求直接返回",
    "type": "bool",
    "default": true,
    "hint": "如今天花了多少钱、还剩多少额度；复杂表达可通过模型调用wechat_query_usage工具。"
  },
  "image_generation": {
    "description": "生图与改图",
    "type": "object",
    "items": {
      "enabled": {
        "description": "启用生图",
        "type": "bool",
        "default": false
      },
      "api_base": {
        "description": "生图API基础地址（含/v1）",
        "type": "string",
        "default": "https://pucoding.com/v1"
      },
      "api_key": {
        "description": "生图API Key",
        "type": "string",
        "default": "",
        "secret": true
      },
      "model": {
        "description": "生图模型",
        "type": "string",
        "default": "gpt-image-2.5-sunburst"
      },
      "quality": {
        "description": "默认质量",
        "type": "string",
        "default": "low",
        "options": [
          "low",
          "medium",
          "high",
          "xhigh",
          "max",
          "auto"
        ]
      },
      "size": {
        "description": "文生图尺寸",
        "type": "string",
        "default": "1024x1024"
      },
      "edit_size": {
        "description": "改图尺寸",
        "type": "string",
        "default": "auto"
      },
      "output_format": {
        "description": "图片格式",
        "type": "string",
        "default": "png",
        "options": [
          "png",
          "jpeg",
          "webp"
        ]
      },
      "background": {
        "description": "背景",
        "type": "string",
        "default": "auto",
        "options": [
          "auto",
          "opaque",
          "transparent"
        ]
      },
      "send_response_format": {
        "description": "显式发送response_format=b64_json",
        "type": "bool",
        "default": false,
        "hint": "通常无需开启；只在兼容服务要求该参数时开启。插件仅接收Base64图片。"
      },
      "timeout": {
        "description": "总超时（秒）",
        "type": "int",
        "default": 420,
        "slider": {
          "min": 180,
          "max": 600,
          "step": 30
        }
      }
    }
  }
}
